# =========================================================================
#  Фрейя — настройки сервера. Скопируйте в .env и заполните.
#  Файл .env В GIT НЕ КЛАДЁМ — в нём ключи и пароль.
# =========================================================================

# ---------------------------- Сеть ----------------------------
# nginx стучится в этот порт, наружу его открывать не надо
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1
# После настройки HTTPS поставьте 1 — cookie админки станет Secure
HTTPS_COOKIES=0

# ------------------------- Где живут данные -------------------------
# ГЛАВНОЕ ПРАВИЛО: эта папка вне папки с кодом.
# Деплой меняет код, а каталог товаров остаётся нетронутым.
DATA_DIR=/srv/freya/data
BACKUPS_KEEP=60

# --------------------------- Пароль админки ---------------------------
# Простой вариант: вписать пароль сюда (сервер сам сделает хеш)
ADMIN_PASSWORD=смените-этот-пароль
# Надёжнее: npm run hash-password — и положить результат сюда, ADMIN_PASSWORD очистить
# ADMIN_PASSWORD_HASH=scrypt$...$...
# Секрет для cookie: openssl rand -hex 32
# Если пусто — сервер сгенерирует сам и сохранит в DATA_DIR/admin.json
SESSION_SECRET=
SESSION_HOURS=12
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_MIN=15

# ------------------------------ Хранилище ------------------------------
# s3    — Timeweb S3 (боевой режим)
# local — файлы на диске в DATA_DIR/media (для проверки без S3)
STORAGE_DRIVER=s3

S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ACL=public-read
S3_PATH_STYLE=1

# Публичный адрес медиа. Подключите CDN — и поменяйте только эту строку.
# Пусто → адрес бакета соберётся автоматически из S3_ENDPOINT и S3_BUCKET.
MEDIA_BASE_URL=

# -------------------------------- Видео --------------------------------
# Все ролики приводятся к этим параметрам на сервере через ffmpeg
VIDEO_MAX_SECONDS=20
VIDEO_FPS=30
VIDEO_SHORT_SIDE=1080
VIDEO_LONG_SIDE=1920
VIDEO_UPSCALE=1
VIDEO_CRF=23
VIDEO_MAXRATE_K=4500
VIDEO_AUDIO_K=128
VIDEO_PRESET=veryfast

# --------------------------------- Фото ---------------------------------
PHOTO_MAIN_SIDE=1400
PHOTO_THUMB_SIDE=500
PHOTO_MAIN_QUALITY=80
PHOTO_THUMB_QUALITY=72

# -------------------------------- Лимиты --------------------------------
UPLOAD_PHOTO_MB=40
UPLOAD_VIDEO_MB=400
CATALOG_MB=12

# ------------------------------- Инструменты -------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
